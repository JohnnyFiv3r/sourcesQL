{
  "mcpServers": {
    "sourcesql-research": {
      "command": "node",
      "args": [
        "--import",
        "./apps/research/node_modules/tsx/dist/loader.mjs",
        "./apps/research/server/main.ts",
        "--stdio"
      ],
      "env": {
        "RESEARCH_DATA_DIR": "local/research",
        "SOURCESQL_DATA_DIR": "local/engine",
        "SOURCESQL_PRINCIPAL": "local-owner",
        "SOURCESQL_ALLOW_PRIVATE": "0",
        "SOURCESQL_PROFILES_FILE": "local/profiles.json"
      }
    }
  }
}
